# ============================================================
# HANA MCP Server - Configuration Example
# Copy this file to .env and fill in your values.
# DO NOT commit .env files to version control.
# ============================================================

# -----------------------------------------------------------------------------
# SAP HANA Connection
# -----------------------------------------------------------------------------
HANA_HOST=hanaroda25.gruporoda.com
HANA_PORT=30015
HANA_USER=B1ADMIN
HANA_PASSWORD=
HANA_SCHEMA=RETAIL
HANA_SSL=false
HANA_ENCRYPT=false
HANA_VALIDATE_CERT=false

# -----------------------------------------------------------------------------
# SUSE Server SSH Access (for remote log inspection scripts)
# -----------------------------------------------------------------------------
SUSE_HOST=hanaroda25.gruporoda.com
SUSE_USER=root
SUSE_PASSWORD=

# -----------------------------------------------------------------------------
# SAP Support / SAP for Me Credentials (for Playwright note fetching)
# -----------------------------------------------------------------------------
SAP_USER=
SAP_PASS=
SAP_NOTE=3733425

# -----------------------------------------------------------------------------
# Licensing
# -----------------------------------------------------------------------------
# License token (JWT) signed by the vendor. Alternatively, create a .hana-license file.
HANA_LICENSE_KEY=

# Optional: enforce online license validation against your cloud endpoint.
# If set, the server will refuse to start if the endpoint is unreachable or returns inactive.
HANA_LICENSE_SERVER_URL=

# Product code registered in the license server (must match the value in mcp_products.code).
HANA_LICENSE_PRODUCT_CODE=hana-b1

# Optional: how often (in hours) to re-check the license with the remote server.
HANA_LICENSE_CHECK_INTERVAL_HOURS=24

# Optional: offline grace period (hours) after a successful online validation.
HANA_LICENSE_OFFLINE_GRACE_HOURS=72

# Optional: telemetry heartbeat interval in minutes.
HANA_TELEMETRY_HEARTBEAT_MINUTES=30

# Optional: disable all telemetry (heartbeats and usage events). Set to true to opt-out.
HANA_DISABLE_TELEMETRY=false

# -----------------------------------------------------------------------------
# Remote Knowledge Base Sync
# -----------------------------------------------------------------------------
# URL of the remote knowledge base repository endpoint.
# The server will download .md files from here on startup (if license allows).
HANA_KB_REMOTE_URL=

# Optional: API key for accessing the remote KB endpoint.
HANA_KB_REMOTE_API_KEY=

# Optional: how often (in hours) to re-sync the remote KB.
HANA_KB_SYNC_INTERVAL_HOURS=24
